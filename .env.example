# SpendWise Environment Configuration Template
# Copy this file to .env and provide your secret credentials.
# NEVER commit the actual .env file with real secrets to version control.

# Django core settings
DJANGO_SECRET_KEY=your-production-django-secret-key-must-be-random-and-secure
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost,testserver,.onrender.com

# PostgreSQL Database (used automatically on Render via internal DATABASE_URL)
DATABASE_URL=postgresql://spendwise_user:your_password@dpg-xxx-a.oregon-postgres.render.com/spendwise_db

# MongoDB Atlas (for Chat History and User Feedback)
MONGODB_URI=mongodb+srv://username:password@cluster0.mongodb.net/?retryWrites=true&w=majority
MONGODB_DATABASE=spendwise

# Cloudinary Permanent Media / Receipt Storage (100% Free Plan)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Third-party Currency Exchange Rate API
EXCHANGE_RATE_API_URL=https://open.er-api.com/v6/latest/USD
EXCHANGE_RATE_API_KEY=

# Security & Hosting (Render)
RENDER_EXTERNAL_HOSTNAME=spendwise-app.onrender.com
CSRF_TRUSTED_ORIGINS=https://*.onrender.com
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True

# Email Backend
DJANGO_EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
